# Build Markdown and LaTeX documents.
#
# Layout:
#   Makefile, main.tex, codeblocks.lua     root document and tooling
#   chapters/foo.md                        source (edit this)
#   chapters/foo.tex                       generated by pandoc (a fragment:
#                                          \chapter/\section, lstlisting code
#                                          blocks, no preamble)
#
# Root documents (ROOTS) \input{chapters/foo} and are built into PDFs next
# to the Makefile.
#
#   make                 convert all chapters/*.md, build every PDF in ROOTS
#   make tex             convert all chapters/*.md to .tex only
#   make main.pdf        build one root document
#   make ROOTS="a b"     build a.pdf and b.pdf instead of main.pdf
#   make clean           remove LaTeX auxiliary files
#   make distclean       also remove PDFs and generated chapters/*.tex

PANDOC   ?= pandoc
# fontspec needs XeLaTeX (or lualatex); pdflatex cannot load system fonts.
ENGINE   ?= xelatex
LATEXMK  ?= latexmk

ROOTS  ?= main
CHDIR  := chapters
FILTER := codeblocks.lua

MD   := $(filter-out $(CHDIR)/README.md,$(wildcard $(CHDIR)/*.md))
GEN  := $(MD:.md=.tex)
PDFS := $(addsuffix .pdf,$(ROOTS))

# Fail with a clear message instead of make's misleading
# "No rule to make target 'chapters/foo.tex'" when an input is missing.
ifneq ($(MAKECMDGOALS),clean)
ifneq ($(MAKECMDGOALS),distclean)
ifeq ($(wildcard $(FILTER)),)
$(error '$(FILTER)' not found in $(CURDIR); copy it next to the Makefile)
endif
ifeq ($(MD),)
$(error no Markdown files found in $(CHDIR)/ (looked in $(CURDIR)))
endif
endif
endif

PANDOC_FLAGS :=-f markdown-auto_identifiers -t latex \
                --top-level-division=chapter --no-highlight --wrap=preserve \
                --lua-filter=$(FILTER)

.PHONY: all tex clean distclean
all: $(PDFS)
tex: $(GEN)

# Markdown -> LaTeX fragment, inside chapters/
$(CHDIR)/%.tex: $(CHDIR)/%.md $(FILTER)
	$(PANDOC) $< $(PANDOC_FLAGS) -o $@

# LaTeX -> PDF with $(ENGINE), in the project root. latexmk reruns until the TOC and
# references settle and tracks \input files itself; without latexmk, fall
# back to two $(ENGINE) passes.
$(PDFS): %.pdf: %.tex preamble.tex $(GEN)
ifneq ($(shell command -v $(LATEXMK) 2>/dev/null),)
	$(LATEXMK) -$(ENGINE) -interaction=nonstopmode -halt-on-error $<
else
	$(ENGINE) -interaction=nonstopmode -halt-on-error $<
	$(ENGINE) -interaction=nonstopmode -halt-on-error $<
endif

clean:
	rm -f $(foreach r,$(ROOTS),$(r).aux $(r).toc $(r).out $(r).log $(r).fls \
	      $(r).fdb_latexmk $(r).xdv)

distclean: clean
	rm -f $(PDFS) $(GEN)
