% preamble.tex -- shared setup for the kernel-development book.
% Loaded from main.tex with \input{preamble}.
% It provides everything the pandoc-generated chapters/*.tex fragments need:
%   amsmath (aligned), array+calc+longtable+booktabs (tables),
%   listings (lstlisting), and \tightlist.

% ---------------------------------------------------------------- fonts
% Requires XeLaTeX or LuaLaTeX (system/OpenType fonts via fontspec); pdfLaTeX
% cannot load them. The Makefile builds with XeLaTeX.
%
% Change a font by editing ONE of these three names. Each is looked up by its
% family name as fontconfig reports it:  fc-list : family | grep -i <name>
% If a font is not installed, the default Latin Modern is used instead.
\providecommand{\bookmainfont}{TeX Gyre Pagella}             % body text (serif)
\providecommand{\booksansfont}{TeX Gyre Heros}               % headings (sans)
\providecommand{\bookmonofont}{Inconsolata Nerd Font Mono}   % code

\usepackage{fontspec}
\IfFontExistsTF{\bookmainfont}{\setmainfont{\bookmainfont}}{}
\IfFontExistsTF{\booksansfont}{\setsansfont[Scale=MatchLowercase]{\booksansfont}}{}
% Nerd Font Mono has regular and bold only, so there is no italic shape;
% Scale=MatchLowercase compensates for Inconsolata's small x-height.
\IfFontExistsTF{\bookmonofont}{\setmonofont[Scale=MatchLowercase]{\bookmonofont}}{}

% ----------------------------------------------------------- chapter style
% NOTE: fncychap redefines \@makechapterhead. KOMA-Script (scrbook) warns that
% this is unsupported and may stop working in a future KOMA release. It renders
% correctly today (checked); if a TeX Live update breaks the headings, switch
% to \documentclass{book} (fncychap's native target) or restyle with
% \setkomafont/\RedeclareSectionCommand.
\usepackage[Bjornstrup]{fncychap}

% --------------------------------------------- required by pandoc fragments
\usepackage{amsmath}                    % aligned
\usepackage{array,calc,longtable,booktabs}  % pandoc tables (\real is in calc)
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% ---------------------------------------------------------------- code
\usepackage{xcolor}
\usepackage{listings}
\usepackage{scrhack}                    % KOMA <-> listings/float list handling

% GNU assembler, AT&T syntax: '#' comments and directives
\lstdefinelanguage{gas}{
  morecomment=[l]{\#},
  morestring=[b]",
  morekeywords={.align,.quad,.long,.word,.byte,.fill,.skip,.set,.rept,.endr,
      .section,.global,.globl,.code32,.code64,.text,.data,.bss},
  sensitive=true,
}

\definecolor{codebg}{gray}{0.96}
\definecolor{codecomment}{rgb}{0.25,0.45,0.25}
\definecolor{codekeyword}{rgb}{0.15,0.2,0.6}

\lstset{
  % language=gas,
  basicstyle=\ttfamily\small, commentstyle=\color{codecomment},
  keywordstyle=\color{codekeyword}, morekeywords={mov, push, pop, cli, lgdt,
      rdmsr, wrmsr, ljmp, cr0, cr3, pml4}, backgroundcolor=\color{codebg},
  columns=fixed, keepspaces=true, breaklines=true, breakatwhitespace=true,
  frame=single, rulecolor=\color{black!25}, framerule=0.3pt, xleftmargin=0.5em,
  xrightmargin=0.5em, aboveskip=0.8em, belowskip=0.8em, }
% no italic in the mono font% monospaced: keep columns aligned
\lstset{
  % Group 1 keywords (default style)
  keywordstyle=\color{codekeyword}, morekeywords={cli, lgdt, rdmsr, wrmsr, ljmp},

  % Group 2 keywords (e.g., registers) in a separate color
  keywordstyle=[2]\color{purple}\bfseries, morekeywords=[2]{rax, rbx, rcx, rdx,
      rsp, rbp, rsi, redi, cr0, cr3, cr4}, } \usepackage[hidelinks]{hyperref}
\newcommand{\passthrough}[1]{#1}
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}%%
